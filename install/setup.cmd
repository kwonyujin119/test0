@echo off
rem Workspace app setup - creates desktop and Start menu shortcuts that open the site as an app window (Chrome or Edge).
set "WS_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:WS_SELF); iex $s.Substring($s.IndexOf('#'+'PS#')+4)"
exit /b
#PS#
$ErrorActionPreference = 'Stop'
$url = 'https://kwonyujin119.github.io/test0/'
$name = '업무 공간'
try {
  $cands = @(
    "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
    "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
    "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe",
    "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
    "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
  )
  $browser = $cands | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1
  if (-not $browser) { Write-Host '크롬이나 엣지를 찾지 못했습니다. 둘 중 하나를 설치한 뒤 다시 실행해 주세요.' -ForegroundColor Red; Read-Host '엔터를 누르면 닫힙니다'; exit }
  $dir = Join-Path $env:LOCALAPPDATA 'WorkspaceApp'
  New-Item -ItemType Directory -Force $dir | Out-Null
  $ico = Join-Path $dir 'workspace.ico'
  [IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String(''))
  $sh = New-Object -ComObject WScript.Shell
  $places = @([Environment]::GetFolderPath('Desktop'), [Environment]::GetFolderPath('Programs'))
  if ($env:WS_TEST_DIR) { $places = @($env:WS_TEST_DIR) }
  foreach ($p in $places) {
    $lnk = $sh.CreateShortcut((Join-Path $p ($name + '.lnk')))
    $lnk.TargetPath = $browser
    $lnk.Arguments = "--app=$url"
    $lnk.WorkingDirectory = Split-Path $browser
    $lnk.IconLocation = "$ico,0"
    $lnk.Description = '업무 공간 — 한글 작업장 · 교안 작업장'
    $lnk.Save()
  }
  Write-Host ''
  Write-Host '  업무 공간 앱을 설치했습니다.' -ForegroundColor Green
  Write-Host '  바탕화면과 시작 메뉴의 [업무 공간] 아이콘으로 여세요.'
  Write-Host '  (작업 표시줄에 고정: 열린 창의 작업 표시줄 아이콘 오른쪽 클릭 -> 작업 표시줄에 고정)'
  Write-Host '  지우려면: 바탕화면·시작 메뉴의 [업무 공간] 아이콘을 지우면 됩니다.'
  if (-not $env:WS_TEST_DIR) { Start-Process $browser "--app=$url"; Start-Sleep -Seconds 6 }
} catch {
  Write-Host ('설치하지 못했습니다: ' + $_.Exception.Message) -ForegroundColor Red
  Read-Host '엔터를 누르면 닫힙니다'
}
